#define _POSIX_C_SOURCE 200809L
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

void strip_newline(char *str) {
  size_t len = strlen(str); 
  if (len > 0 && str[len - 1] == '\n') {
    str[len - 1] = '\0';
  }
}

int main(void) {
  char *line = NULL;
  size_t len = 0;
  ssize_t read;
  
  char *history[5] = {NULL}; // our memory that stores pointers to the strings that is inputed
  
  int history_index = 0; // current writable index in history array
                         
  while (true) {
    printf("Enter input: ");
    size_t input = getline(&line, &len, stdin);
    if (input == -1) {
      break;
    }
    
    strip_newline(line);
    
    // checking if the history index is occupied
    if (history[history_index] != NULL) {
      free(history[history_index]);
    }

    history[history_index] = strdup(line);



    // history_index = (i+1 % 5)


    
  }
}
